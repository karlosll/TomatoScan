# Copia este archivo como ".env" y ajusta los valores.
# Si NO creas el .env, el proyecto arranca igual usando SQLite.

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Umbrales opcionales del diagnóstico (valores entre 0 y 1):
UMBRAL_CONFIANZA=0.55
UMBRAL_CONSENSO=1.0

# PostgreSQL (recomendado para la entrega):
# 1) Crea la base:  CREATE DATABASE tomate_db;  (desde pgAdmin o psql)
# 2) Descomenta y ajusta:
# DATABASE_URL=postgres://postgres:tu_clave@localhost:5432/tomate_db
